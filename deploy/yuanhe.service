[Unit]
Description=Yuanhe (Lumera) online card game server
After=network.target

[Service]
Type=simple
User=yuanhe
WorkingDirectory=/opt/yuanhe
ExecStart=/usr/bin/node /opt/yuanhe/server.js
Environment=PORT=8787
Environment=HOST=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/yuanhe
PrivateTmp=true

[Install]
WantedBy=multi-user.target
