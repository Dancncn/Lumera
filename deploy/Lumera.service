[Unit]
Description=Lumera online card game server
After=network.target

[Service]
Type=simple
User=lumera
WorkingDirectory=/opt/Lumera
ExecStart=/usr/bin/node /opt/Lumera/current/server.js
Environment=PORT=8787
Environment=HOST=127.0.0.1
Environment=STATS_FILE=/opt/Lumera/shared/state/stats.json
EnvironmentFile=-/opt/Lumera/shared/environment
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/Lumera/shared
PrivateTmp=true

[Install]
WantedBy=multi-user.target
